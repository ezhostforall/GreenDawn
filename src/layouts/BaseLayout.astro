---
import "@fontsource/archivo/latin-400.css";
import "@fontsource/archivo/latin-600.css";
import "@fontsource/archivo/latin-700.css";
import "@fontsource/bricolage-grotesque/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";
import { siteConfig } from "../config/site";
import { assetPath } from "../lib/urls";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/brand/greendawn-social-preview.jpg",
} = Astro.props;

const isPreview = import.meta.env.PUBLIC_PREVIEW === "true";
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL(assetPath(image), Astro.site) : undefined;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteConfig.liveUrl}/#organization`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.liveUrl,
  logo: `${siteConfig.liveUrl}/brand/greendawn-wordmark-480.png`,
  email: siteConfig.email.display,
  telephone: siteConfig.phone.display,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Office 2.026, Innovation Centre, 7 University Avenue",
    addressLocality: "Keele",
    addressRegion: "Staffordshire",
    postalCode: "ST5 5NU",
    addressCountry: "GB",
  },
  sameAs: [siteConfig.linkedinUrl],
};
---

<!doctype html>
<html class="no-js" lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={isPreview ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#0b1d2a" />
    <meta name="color-scheme" content="light" />
    {canonicalUrl && !isPreview && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="Greendawn engineers delivering commercial EV charging infrastructure" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="icon" type="image/png" href={assetPath("/brand/greendawn-mark.png")} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    ></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
