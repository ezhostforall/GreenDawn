---
import type { Solution } from "../../types/home";
import type { HTMLAttributes } from "astro/types";
import ResponsiveImage from "../media/ResponsiveImage.astro";

type Props = Omit<HTMLAttributes<"figure">, "class"> & {
  solution: Solution;
  index: number;
  active?: boolean;
  class?: string;
};

const { solution, index, active = false, class: className, ...attributes } = Astro.props;
---

<figure
  {...attributes}
  class:list={["solution-image", className, { "is-active": active }]}
  data-solution-image={index}
>
  <ResponsiveImage
    image={solution.image}
    alt=""
    sizes="(min-width: 62rem) 45vw, 1px"
    loading="lazy"
  />
  <figcaption><span>{solution.number}</span>{solution.title}</figcaption>
</figure>

<style is:global>
.solution-image {
  position: absolute;
  inset: 0;
  margin: 0;
  visibility: hidden;
}

.solution-image.is-active {
  visibility: visible;
}

.solution-image::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(7, 23, 33, 0.78), transparent 52%);
  content: "";
}

.solution-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--image-position);
}

.solution-image figcaption {
  position: absolute;
  z-index: 2;
  right: 2rem;
  bottom: 2rem;
  left: 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  color: var(--cream);
  font-family: var(--font-body);
  font-size: var(--step-2);
  font-weight: 600;
  letter-spacing: -0.03em;
}

.solution-image figcaption span {
  color: var(--lime);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0;
}

@media (max-width: 42rem) {
  .solution-image img {
    object-position: var(--image-position-mobile);
  }
}
</style>
