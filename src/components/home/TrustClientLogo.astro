---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"li">, "class"> & {
  src: ImageMetadata;
  alt: string;
  variant: "johnsons" | "salvation-army";
  class?: string;
  imageClass?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
};

const {
  src,
  alt,
  variant,
  class: className,
  imageClass,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  ...attributes
} = Astro.props;
const format = variant === "johnsons" ? "png" as const : undefined;
---

<li {...attributes} class:list={["trust-client", `trust-client--${variant}`, className]}>
  <Image
    src={src}
    alt={alt}
    class:list={["trust-client__logo", `trust-client__logo--${variant}`, imageClass]}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    format={format}
  />
</li>

<style is:global>
.trust-client {
  display: grid;
  min-width: 0;
  min-height: 4rem;
  place-items: center;
  overflow: hidden;
  border: 1px solid var(--border-dark);
  border-radius: var(--radius-md);
  background: var(--white);
  padding: clamp(0.4rem, 0.8vw, 0.65rem);
}

.trust-client__logo {
  display: block;
  width: auto;
  max-width: 100%;
  height: auto;
}

.trust-client__logo--johnsons {
  max-height: 2.75rem;
}

.trust-client__logo--salvation-army {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 2.5rem;
  object-fit: contain;
}
</style>
