---
import type { SupportingProof } from "../../types/home";
import type { HTMLAttributes } from "astro/types";
import ResponsiveImage from "../media/ResponsiveImage.astro";

type Props = Omit<HTMLAttributes<"article">, "class"> & {
  item: SupportingProof;
  tabletWide?: boolean;
  mobileDefault?: boolean;
  class?: string;
};

const {
  item,
  tabletWide = false,
  mobileDefault = false,
  class: className,
  ...attributes
} = Astro.props;
---

<article {...attributes} class:list={[
  "proof-card",
  className,
  `proof-card--${item.kind}`,
  { "proof-card--tablet-wide": tabletWide, "proof-card--mobile-default": mobileDefault },
]}>
  {item.image && item.alt && (
    <figure>
      <ResponsiveImage
        image={item.image}
        alt={item.alt}
        sizes="(max-width: 42rem) calc(100vw - 1.5rem), (max-width: 61rem) calc(50vw - 2rem), 44vw"
        loading="lazy"
      />
      <figcaption>{item.eyebrow}</figcaption>
    </figure>
  )}
  {!item.image && <span class="proof-card__label">{item.eyebrow}</span>}
  <div class="proof-card__body">
    <h3>{item.title}</h3>
    <strong>{item.result}</strong>
    <p>{item.copy}</p>
  </div>
</article>

<style is:global>
.proof-card {
  min-width: 0;
}

.proof-card figure {
  position: relative;
  aspect-ratio: 1.45;
  overflow: hidden;
  margin: 0 0 1.4rem;
  border-radius: var(--radius-md);
  background: var(--navy-800);
}

.proof-card figure::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(7, 23, 33, 0.72), transparent 55%);
  content: "";
}

.proof-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--image-position);
  transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
}

.proof-card:hover img {
  transform: scale(1.055);
}

.proof-card figcaption {
  position: absolute;
  z-index: 1;
  bottom: 1rem;
  left: 1rem;
  color: var(--cream);
  font-family: var(--font-mono);
  font-size: 0.71rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.proof-card__body h3 {
  margin-bottom: 0.5rem;
  font-size: var(--type-card);
}

.proof-card__body > strong {
  display: block;
  margin-bottom: 0.75rem;
  color: var(--violet);
  font-size: var(--step--1);
  line-height: 1.4;
}

.proof-card__body > p {
  margin-bottom: 0;
  color: var(--slate-500);
  font-size: var(--step--1);
  line-height: 1.6;
}

.proof-card--coverage,
.proof-card--capability {
  min-height: 23rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1px solid var(--border-dark);
  border-radius: var(--radius-md);
  padding: clamp(1.6rem, 2.8vw, 2.5rem);
}

.proof-card--coverage {
  background: var(--navy-900);
  color: var(--cream);
}

.proof-card--capability {
  background: var(--lime);
}

.proof-card__label {
  color: var(--violet);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.proof-card--coverage .proof-card__label,
.proof-card--coverage .proof-card__body > strong {
  color: var(--lime);
}

.proof-card--coverage .proof-card__body > p {
  color: var(--slate-300);
}

.proof-card--capability .proof-card__body > strong,
.proof-card--capability .proof-card__body > p {
  color: var(--navy-900);
}

@media (max-width: 61rem) {
  .proof-card--tablet-wide {
    grid-column: 1 / -1;
    width: auto;
  }
}

@media (max-width: 42rem) {
  .proof-card img {
    object-position: var(--image-position-mobile);
  }

  .proof-card--mobile-default {
    grid-column: auto;
    width: auto;
  }

  .proof-card--coverage,
  .proof-card--capability {
    min-height: 14rem;
    padding: 1.5rem;
  }

  .proof-card__body h3 {
    font-size: 1.5rem;
    line-height: 1.08;
  }

  .proof-card__body > strong,
  .proof-card__body > p {
    font-size: var(--step--1);
  }
}

@media (hover: none) and (max-width: 61rem) {
  .proof-card:hover img {
    transform: none;
  }
}
</style>
