---
import ResponsiveImage from "../media/ResponsiveImage.astro";
import ArrowIcon from "../media/ArrowIcon.astro";
import { audiences } from "../../content/home";
import { liveSitePath } from "../../lib/urls";
---

<section class="solutions section section--cream" id="who-we-help" data-solutions>
  <div class="page-shell">
    <div class="section-title-row" data-reveal>
      <div>
        <p class="eyebrow">Who we help</p>
        <h2>Charging built around your operation.</h2>
      </div>
      <p>The right specification follows the users, dwell time, available power and operational need.</p>
    </div>

    <div class="solutions__layout">
      <div class="solutions__media" aria-hidden="true">
        {audiences.map((solution, index) => (
          <figure class:list={["solution-image", { "is-active": index === 0 }]} data-solution-image={index}>
            <ResponsiveImage
              image={solution.image}
              alt=""
              sizes="(min-width: 62rem) 45vw, 1px"
              loading="lazy"
            />
            <figcaption><span>{solution.number}</span>{solution.title}</figcaption>
          </figure>
        ))}
      </div>

      <div class="solutions__list">
        {audiences.map((solution, index) => (
          <a class:list={["solution-row", { "is-active": index === 0 }]} href={liveSitePath(solution.href)} data-solution-row={index}>
            <span class="solution-row__number">{solution.number}</span>
            <div class="solution-row__body">
              <div class="solution-row__copy">
                <h3>{solution.title}</h3>
                <p>{solution.copy}</p>
              </div>
            </div>
            <span class="solution-row__arrow"><ArrowIcon direction="up-right" /></span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
