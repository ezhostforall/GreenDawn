---
import { audiences } from "../../content/home";
import SolutionImage from "./SolutionImage.astro";
import SolutionRow from "./SolutionRow.astro";
---

<section class="solutions section section--cream" id="who-we-help" data-solutions>
  <div class="page-shell">
    <div class="section-title-row" data-reveal>
      <div>
        <p class="eyebrow">Who we help</p>
        <h2>Charging built around your operation.</h2>
      </div>
      <p>The right specification follows the users, dwell time, available power and operational need.</p>
    </div>

    <div class="solutions__layout">
      <div class="solutions__media" aria-hidden="true">
        {audiences.map((solution, index) => (
          <SolutionImage solution={solution} index={index} active={index === 0} />
        ))}
      </div>

      <div class="solutions__list">
        {audiences.map((solution, index) => (
          <SolutionRow solution={solution} index={index} active={index === 0} />
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
.solutions__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(28rem, 1fr);
  align-items: start;
  gap: clamp(3rem, 6vw, 6rem);
}

.solutions__layout > * {
  min-width: 0;
}

.solutions__media {
  position: sticky;
  top: 6.25rem;
  width: 100%;
  min-width: 0;
  height: min(64svh, 38rem);
  max-height: calc(100svh - 8rem);
  align-self: start;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--navy-800);
  box-shadow: var(--shadow-lg);
}

.solutions__list {
  border-top: 1px solid var(--navy-900);
}

@media (max-width: 75rem) {
  .solutions__layout {
    gap: 4rem;
  }
}

@media (max-width: 61rem) {
  .solutions__layout {
    grid-template-columns: 1fr;
  }

  .solutions__media {
    position: relative;
    top: 0;
    display: block;
    height: clamp(20rem, 62vw, 32rem);
    max-height: none;
  }
}

@media (max-height: 44rem) and (max-width: 75rem) {
  .solutions__media {
    position: relative;
    top: 0;
    height: auto;
    max-height: min(24rem, 62svh);
    aspect-ratio: 4 / 3;
  }
}
</style>
