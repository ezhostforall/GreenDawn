---
import { surveyTiers } from "../../content/home";
import { liveSitePath } from "../../lib/urls";
import ArrowIcon from "../media/ArrowIcon.astro";
import SurveyTier from "./SurveyTier.astro";
import SurveyTierMobile from "./SurveyTierMobile.astro";
---

<section class="surveys section section--paper" id="surveys" aria-labelledby="surveys-title" data-surveys>
  <div class="page-shell">
    <div class="surveys__intro" data-reveal>
      <p class="eyebrow">Technical site surveys</p>
      <div>
        <h2 id="surveys-title">Replace assumptions with a buildable plan.</h2>
        <p>
          Start with a conversation. Where an on-site survey is appropriate, Greendawn assesses locations, electrical routes and practical constraints to develop a dependable scope.
        </p>
      </div>
    </div>

    <div class="surveys__grid">
      {surveyTiers.map((tier, index) => <SurveyTier tier={tier} index={index} total={surveyTiers.length} />)}
    </div>

    <div class="surveys__mobile" aria-label="Technical site survey comparison">
      {surveyTiers.map((tier, index) => (
        <SurveyTierMobile tier={tier} last={index === surveyTiers.length - 1} />
      ))}
    </div>

    <div class="surveys__footer" data-reveal>
      <p>Prices exclude VAT. Third-party DNO, IDNO and local-authority costs are additional where applicable. Final scope, payment and any installation credit are confirmed before the survey is booked.</p>
      <a class="text-link" href={liveSitePath("/guides/greendawn-ev-charging-survey-pre-installation-guide/")}>What a technical survey should establish <ArrowIcon /></a>
    </div>
  </div>
</section>

<style is:global>
.surveys__intro {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  align-items: start;
  gap: 4rem;
  margin-bottom: clamp(3rem, 5vw, 4.5rem);
}

.surveys__intro .eyebrow {
  color: var(--navy-900);
}

.surveys__intro h2 {
  max-width: 12ch;
  margin-bottom: 0;
}

.surveys__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 2px solid var(--navy-900);
  border-bottom: 2px solid var(--navy-900);
}

.surveys__mobile {
  display: none;
}

.surveys__intro > div > p {
  max-width: 44rem;
  margin: 1.5rem 0 0;
  color: rgba(11, 29, 42, 0.72);
  line-height: 1.7;
}

.surveys__footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2rem;
  margin-top: 1.6rem;
}

.surveys__footer p {
  max-width: 52rem;
  margin: 0;
  color: rgba(11, 29, 42, 0.72);
  font-size: 0.76rem;
  line-height: 1.6;
}

.surveys__footer .text-link {
  flex: 0 0 auto;
}

@media (max-width: 75rem) {
  .surveys__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 61rem) {
  .surveys__intro {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .surveys__grid {
    grid-template-columns: 1fr 1fr;
  }

  .surveys__footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 42rem) {
  .surveys__grid {
    display: none;
  }

  .surveys__mobile {
    display: block;
    border-top: 2px solid var(--navy-900);
    border-bottom: 2px solid var(--navy-900);
  }
}
</style>
