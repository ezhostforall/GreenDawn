---
import { liveSitePath } from "../../lib/urls";
import ArrowIcon from "../media/ArrowIcon.astro";

const surveyOutcomes = [
  "Whether the site can support the required charging demand",
  "Where chargers, equipment and cable routes should go",
  "What electrical, civil and network work may be needed",
  "A documented scope that can be quoted and delivered with confidence",
] as const;
---

<section class="surveys section section--paper" id="surveys" aria-labelledby="surveys-title" data-surveys>
  <div class="page-shell">
    <div class="surveys__intro" data-reveal>
      <p class="eyebrow">Technical site surveys</p>
      <div>
        <h2 id="surveys-title">Replace assumptions with a buildable plan.</h2>
        <p>
          Start with a conversation. If an on-site survey is the sensible next step, Greendawn checks the proposed charging area, electrical infrastructure and delivery constraints before design begins.
        </p>
      </div>
    </div>

    <div class="surveys__overview">
      <div class="surveys__price" data-reveal>
        <p class="surveys__price-label">Site surveys from</p>
        <p class="surveys__price-value"><strong>£200</strong><span>+ VAT</span></p>
        <p>
          Scope and cost reflect the size of the site, charger numbers and technical complexity. We confirm both before a survey is booked.
        </p>
      </div>

      <div class="surveys__outcomes" data-reveal>
        <h3>What the survey establishes</h3>
        <ol>
          {surveyOutcomes.map((outcome, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{outcome}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="surveys__footer" data-reveal>
      <p>A survey is recommended only where it adds useful technical certainty. Third-party DNO, IDNO and local-authority costs are additional where applicable.</p>
      <a class="text-link" href={liveSitePath("/guides/greendawn-ev-charging-survey-pre-installation-guide/")}>What a technical survey should establish <ArrowIcon /></a>
    </div>
  </div>
</section>

<style is:global>
.surveys__intro {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  align-items: start;
  gap: 4rem;
  margin-bottom: clamp(3rem, 5vw, 4.5rem);
}

.surveys__intro .eyebrow {
  color: var(--navy-900);
}

.surveys__intro h2 {
  max-width: 12ch;
  margin-bottom: 0;
}

.surveys__intro > div > p {
  max-width: 44rem;
  margin: 1.5rem 0 0;
  color: rgba(11, 29, 42, 0.72);
  line-height: 1.7;
}

.surveys__overview {
  display: grid;
  grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
  border-top: 2px solid var(--navy-900);
  border-bottom: 2px solid var(--navy-900);
}

.surveys__price {
  display: flex;
  min-width: 0;
  min-height: 24rem;
  flex-direction: column;
  justify-content: space-between;
  background: var(--navy-900);
  color: var(--cream);
  padding: clamp(2rem, 4vw, 4rem);
}

.surveys__price-label {
  margin: 0;
  color: var(--lime);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.surveys__price-value {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  margin: auto 0 2rem;
}

.surveys__price-value strong {
  font-family: var(--font-mono);
  font-size: clamp(4rem, 8vw, 7.5rem);
  font-weight: 600;
  letter-spacing: -0.085em;
  line-height: 0.82;
}

.surveys__price-value span {
  color: var(--lime);
  font-family: var(--font-mono);
  font-size: clamp(0.8rem, 1.2vw, 1rem);
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.surveys__price > p:last-child {
  max-width: 31rem;
  margin: 0;
  color: var(--slate-200);
  line-height: 1.7;
}

.surveys__outcomes {
  min-width: 0;
  padding: clamp(2rem, 4vw, 4rem);
}

.surveys__outcomes h3 {
  max-width: 13ch;
  margin: 0 0 clamp(2.5rem, 5vw, 4.5rem);
  font-size: var(--type-heading);
}

.surveys__outcomes ol {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 2rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.surveys__outcomes li {
  display: grid;
  min-width: 0;
  grid-template-columns: 2rem minmax(0, 1fr);
  gap: 0.8rem;
  border-top: 1px solid var(--border-dark);
  padding: 1.25rem 0;
}

.surveys__outcomes li > span {
  color: var(--violet);
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

.surveys__outcomes li > p {
  margin: 0;
  line-height: 1.55;
}

.surveys__footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2rem;
  margin-top: 1.6rem;
}

.surveys__footer p {
  max-width: 52rem;
  margin: 0;
  color: rgba(11, 29, 42, 0.72);
  font-size: 0.76rem;
  line-height: 1.6;
}

.surveys__footer .text-link {
  flex: 0 0 auto;
}

@media (max-width: 61rem) {
  .surveys__intro {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .surveys__overview {
    grid-template-columns: 1fr;
  }

  .surveys__price {
    min-height: 19rem;
  }

  .surveys__footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 42rem) {
  .surveys__price {
    min-height: 17rem;
    padding: 2rem 1.5rem;
  }

  .surveys__price-value {
    margin-bottom: 1.5rem;
  }

  .surveys__price-value strong {
    font-size: clamp(3.8rem, 20vw, 5.5rem);
  }

  .surveys__outcomes {
    padding: 2.5rem 0 1rem;
  }

  .surveys__outcomes h3 {
    margin-bottom: 2rem;
  }

  .surveys__outcomes ol {
    grid-template-columns: 1fr;
  }
}
</style>
