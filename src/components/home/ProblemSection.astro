---
import FragmentedModel from "./FragmentedModel.astro";
---

<section class="problem section section--cream" data-section="problem">
  <div class="page-shell problem__layout">
    <div class="section-intro section-intro--sticky" data-reveal>
      <p class="eyebrow">Why Greendawn</p>
      <h2>Commercial EV charging is more than choosing a charger.</h2>
      <p>
        Power, groundworks, hardware, software, payments and support affect one another. Separate them and the customer manages the gaps.
      </p>
    </div>

    <FragmentedModel />
  </div>
</section>

<style is:global>
.problem {
  border-top: 1px solid var(--border-dark);
}

.problem__layout {
  display: grid;
  grid-template-columns: minmax(18rem, 0.8fr) minmax(30rem, 1.2fr);
  gap: clamp(4rem, 10vw, 11rem);
}

.section-intro--sticky {
  position: sticky;
  top: 8rem;
  align-self: start;
}

.section-intro > h2 {
  max-width: 14ch;
  margin-bottom: var(--space-5);
}

.section-intro > p:last-child {
  max-width: 40rem;
  color: var(--slate-500);
  line-height: 1.75;
}

@media (max-width: 75rem) {
  .problem__layout {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
}

@media (max-width: 61rem) {
  .problem__layout {
    grid-template-columns: 1fr;
  }

  .section-intro--sticky {
    position: static;
  }
}
</style>
