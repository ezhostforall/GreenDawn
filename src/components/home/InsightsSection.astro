---
import ArrowIcon from "../media/ArrowIcon.astro";
import { insights } from "../../content/home";
import { liveSitePath } from "../../lib/urls";
import InsightCard from "./InsightCard.astro";
---

<section class="insights section section--cream" id="insights">
  <div class="page-shell">
    <div class="section-title-row section-title-row--compact" data-reveal>
      <div>
        <p class="eyebrow">Commercial EV charging guidance</p>
        <h2>Make better-informed charging decisions.</h2>
      </div>
      <a class="text-link" href={liveSitePath("/blog/")}>Visit the insight centre <ArrowIcon /></a>
    </div>

    <div class="insights__grid">
      {insights.map((insight, index) => (
        <InsightCard
          insight={insight}
          tabletWide={index === insights.length - 1}
          mobileDefault={index === insights.length - 1}
        />
      ))}
    </div>
  </div>
</section>

<style is:global>
.insights__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(1.4rem, 2.5vw, 2.4rem);
}

@media (max-width: 75rem) {
  .insights__grid {
    gap: 1.3rem;
  }
}

@media (max-width: 61rem) {
  .insights__grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 42rem) {
  .insights__grid {
    grid-template-columns: 1fr;
  }
}
</style>
