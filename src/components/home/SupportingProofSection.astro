---
import ResponsiveImage from "../media/ResponsiveImage.astro";
import { supportingProof } from "../../content/home";
import { liveSitePath } from "../../lib/urls";
import ArrowIcon from "../media/ArrowIcon.astro";
---

<section class="proof-grid section section--cream" aria-labelledby="proof-grid-title">
  <div class="page-shell">
    <div class="section-title-row section-title-row--compact" data-reveal>
      <div>
        <p class="eyebrow">Built for real-world commercial sites</p>
        <h2 id="proof-grid-title">Different operations. One managed approach.</h2>
      </div>
      <a class="text-link" href={liveSitePath("/gallery/")}>View project experience <ArrowIcon /></a>
    </div>

    <div class="proof-grid__items">
      {supportingProof.map((item) => (
        <article class="proof-card" data-reveal>
          <figure>
            <ResponsiveImage
              image={item.image}
              alt={item.alt}
              sizes="(max-width: 42rem) calc(100vw - 1.5rem), (max-width: 61rem) calc(50vw - 2rem), 30vw"
              loading="lazy"
            />
            <figcaption>{item.eyebrow}</figcaption>
          </figure>
          <h3>{item.title}</h3>
          <strong>{item.result}</strong>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
