---
import { siteConfig } from "../../config/site";
import { assetPath, liveSitePath } from "../../lib/urls";
import ArrowIcon from "../media/ArrowIcon.astro";
---

<header class="site-header" data-header>
  <div class="site-header__inner page-shell">
    <a class="brand" href="#top" aria-label={`${siteConfig.name} homepage`}>
      <img src={assetPath("/brand/greendawn-wordmark-480.png")} alt={siteConfig.name} width="480" height="132" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#process">How we work</a>
      <a href="#who-we-help">Who we help</a>
      <a href="#aftercare">Aftercare</a>
      <a href="#projects">Projects</a>
      <a href="#insights">Insights</a>
    </nav>

    <a class="header-cta" href={liveSitePath("/enquire/")}>
      Discuss your site
      <ArrowIcon direction="up-right" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">
      <span class="sr-only">Open navigation</span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-navigation" aria-hidden="true" inert>
    <nav aria-label="Mobile navigation">
      <a href="#process"><span>01</span>How we work</a>
      <a href="#who-we-help"><span>02</span>Who we help</a>
      <a href="#aftercare"><span>03</span>Aftercare</a>
      <a href="#projects"><span>04</span>Projects</a>
      <a href="#insights"><span>05</span>Insights</a>
    </nav>
    <a class="button button--lime" href={liveSitePath("/enquire/")}>Discuss your site <ArrowIcon direction="up-right" /></a>
    <p><a href={siteConfig.phone.href}>{siteConfig.phone.display}</a> · <a href={liveSitePath("/customer-care/")}>Support</a></p>
  </div>
</header>

<style is:global>
body.menu-open {
  overflow: hidden;
}

.site-header {
  position: absolute;
  z-index: 90;
  top: 2.35rem;
  right: 0;
  left: 0;
  min-height: 5.5rem;
  border-bottom: 1px solid var(--border-light);
  color: var(--cream);
  transition: min-height 240ms ease, background-color 240ms ease, box-shadow 240ms ease, transform 240ms ease;
}

.site-header__inner {
  display: grid;
  min-height: inherit;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: clamp(1.5rem, 4vw, 4rem);
}

.site-header.is-scrolled {
  position: fixed;
  top: 0;
  min-height: 4.7rem;
  border-bottom-color: rgba(250, 249, 246, 0.11);
  background: rgba(7, 23, 33, 0.94);
  box-shadow: 0 9px 35px rgba(7, 23, 33, 0.22);
  backdrop-filter: blur(16px);
}

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(1.35rem, 2.4vw, 2.7rem);
}

.desktop-nav a {
  position: relative;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 400;
  letter-spacing: 0.015em;
}

.desktop-nav a::after {
  position: absolute;
  right: 0;
  bottom: -0.55rem;
  left: 0;
  height: 2px;
  transform: scaleX(0);
  transform-origin: right;
  background: var(--lime);
  content: "";
  transition: transform 220ms ease;
}

.desktop-nav a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.desktop-nav a[aria-current="location"]::after {
  transform: scaleX(1);
  transform-origin: left;
}

.header-cta {
  display: inline-flex;
  min-height: 2.7rem;
  align-items: center;
  justify-content: space-between;
  justify-self: end;
  gap: 2.2rem;
  border-radius: var(--radius-sm);
  background: var(--cream);
  color: var(--navy-900);
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 600;
  padding: 0.65rem 0.85rem;
  transition: background-color 180ms ease, transform 180ms ease;
}

.header-cta:hover {
  transform: translateY(-2px);
  background: var(--lime);
}

.menu-toggle,
.mobile-nav {
  display: none;
}

@media (max-width: 75rem) {
  .site-header__inner {
    z-index: 130;
    grid-template-columns: 1fr auto;
  }

  .site-header.menu-active {
    position: fixed;
    top: 0;
    min-height: 5.5rem;
    border-bottom-color: transparent;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .site-header .brand {
    position: relative;
    z-index: 102;
  }

  .desktop-nav,
  .header-cta {
    display: none;
  }

  .menu-toggle {
    position: relative;
    z-index: 102;
    display: block;
    width: 2.8rem;
    height: 2.8rem;
    justify-self: end;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle > span:not(.sr-only) {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 1px;
    transform: translateX(-50%);
    background: currentColor;
    transition: transform 220ms ease, top 220ms ease;
  }

  .menu-toggle > span:nth-child(2) {
    top: 1.08rem;
  }

  .menu-toggle > span:nth-child(3) {
    top: 1.65rem;
  }

  .menu-toggle[aria-expanded="true"] > span:nth-child(2) {
    top: 1.35rem;
    transform: translateX(-50%) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] > span:nth-child(3) {
    top: 1.35rem;
    transform: translateX(-50%) rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: flex;
    height: 100dvh;
    min-height: 100dvh;
    transform: translateY(-1.5rem);
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--navy-950);
    color: var(--cream);
    opacity: 0;
    padding: max(7rem, calc(env(safe-area-inset-top) + 6rem)) max(2rem, env(safe-area-inset-right)) max(2rem, env(safe-area-inset-bottom)) max(2rem, env(safe-area-inset-left));
    pointer-events: none;
    visibility: hidden;
    transition: opacity 220ms ease, transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 320ms;
  }

  .mobile-nav.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-light);
  }

  .mobile-nav nav a {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid var(--border-light);
    font-family: var(--font-body);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    padding-block: 0.8rem;
  }

  .mobile-nav nav span {
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0;
  }

  .mobile-nav nav a[aria-current="location"] {
    padding-left: 0.85rem;
  }

  .mobile-nav nav a[aria-current="location"]::after {
    width: 0.65rem;
    height: 0.65rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--lime);
    content: "";
  }

  .mobile-nav .button {
    align-self: flex-start;
    margin-top: 2rem;
  }

  .mobile-nav > p {
    margin: auto 0 0;
    color: var(--slate-300);
    font-size: var(--step--1);
  }
}

@media (max-width: 42rem) {
  .site-header {
    top: 2.65rem;
    min-height: 4.7rem;
  }

  .site-header.menu-active {
    top: 0;
    min-height: 4.7rem;
  }

  .mobile-nav {
    padding-inline: max(1.25rem, env(safe-area-inset-left)) max(1.25rem, env(safe-area-inset-right));
  }

  .mobile-nav nav a {
    min-height: 4.3rem;
    font-size: clamp(1.75rem, 8vw, 2.75rem);
  }
}

@media (max-height: 44rem) and (max-width: 75rem) {
  .mobile-nav {
    padding-top: max(5.5rem, calc(env(safe-area-inset-top) + 5rem));
  }

  .mobile-nav nav a {
    min-height: 3.5rem;
    font-size: clamp(1.45rem, 5.2vh, 2.2rem);
  }

  .mobile-nav .button {
    min-height: 3rem;
    margin-top: 1.2rem;
  }
}
</style>
