---
import { siteConfig } from "../../config/site";
import { assetPath, liveSitePath } from "../../lib/urls";
import ArrowIcon from "../media/ArrowIcon.astro";
---

<footer class="footer">
  <div class="page-shell">
    <div class="footer__lead">
      <a class="brand brand--footer" href="#top" aria-label={`${siteConfig.name} homepage`}>
        <img src={assetPath("/brand/greendawn-wordmark-480.png")} alt={siteConfig.name} width="480" height="132" />
      </a>
      <p>EV charging. Handled.</p>
    </div>

    <div class="footer__grid">
      <div>
        <span>Solutions</span>
        <a href={liveSitePath("/fleet-charging-solutions/")}>Fleet & depot</a>
        <a href={liveSitePath("/workplace-charging/")}>Workplace</a>
        <a href={liveSitePath("/public-charging/")}>Destination & public</a>
        <a href={liveSitePath("/guides/ev-charging-for-car-dealership/")}>Dealerships</a>
      </div>
      <div>
        <span>How we work</span>
        <a href="#system">Foundations first</a>
        <a href="#process">Delivery process</a>
        <a href="#power">Grid & power</a>
        <a href="#surveys">Technical surveys</a>
      </div>
      <div>
        <span>Company</span>
        <a href={liveSitePath("/about-us/")}>About GreenDawn</a>
        <a href={liveSitePath("/gallery/")}>Projects</a>
        <a href={liveSitePath("/blog/")}>Insights</a>
        <a href={liveSitePath("/customer-care/")}>Customer support</a>
      </div>
      <div class="footer__contact">
        <span>Contact</span>
        <a href={siteConfig.phone.href}>{siteConfig.phone.display}</a>
        <a href={siteConfig.email.href}>{siteConfig.email.display}</a>
        <p>{siteConfig.registeredAddressLines[0]}<br />{siteConfig.registeredAddressLines[1]}<br />{siteConfig.registeredAddressLines[2]}</p>
      </div>
    </div>

    <div class="footer__base">
      <span>© {siteConfig.legalName} · Company {siteConfig.companyNumber} · VAT {siteConfig.vatNumber}</span>
      <a href={liveSitePath("/privacy-policy/")}>Privacy</a>
      <a href={liveSitePath("/modern-slavery-statements/")}>Modern Slavery</a>
      <a href={siteConfig.linkedinUrl}>LinkedIn <ArrowIcon direction="up-right" /></a>
    </div>
  </div>
</footer>
