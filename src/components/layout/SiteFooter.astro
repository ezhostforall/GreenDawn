---
import { siteConfig } from "../../config/site";
import { assetPath, liveSitePath } from "../../lib/urls";
import ArrowIcon from "../media/ArrowIcon.astro";
---

<footer class="footer">
  <div class="page-shell">
    <div class="footer__lead">
      <a class="brand brand--footer" href="#top" aria-label={`${siteConfig.name} homepage`}>
        <img src={assetPath("/brand/greendawn-wordmark-480.png")} alt={siteConfig.name} width="480" height="132" />
      </a>
      <p>EV charging. Handled.</p>
    </div>

    <div class="footer__grid">
      <div>
        <span>Who we help</span>
        <a href={liveSitePath("/fleet-charging-solutions/")}>Fleet & depot</a>
        <a href={liveSitePath("/workplace-charging/")}>Workplace</a>
        <a href={liveSitePath("/public-charging/")}>Destination & public</a>
        <a href={liveSitePath("/guides/ev-charging-for-car-dealership/")}>Dealerships</a>
      </div>
      <div>
        <span>How we work</span>
        <a href="#system">Foundations first</a>
        <a href="#process">Delivery process</a>
        <a href="#system">Site power planning</a>
        <a href="#surveys">Technical surveys</a>
      </div>
      <div>
        <span>Company</span>
        <a href={liveSitePath("/about-us/")}>About Greendawn</a>
        <a href={liveSitePath("/gallery/")}>Projects</a>
        <a href={liveSitePath("/blog/")}>Insights</a>
        <a href={liveSitePath("/customer-care/")}>Customer support</a>
      </div>
      <div class="footer__contact">
        <span>Contact</span>
        <a href={siteConfig.phone.href}>{siteConfig.phone.display}</a>
        <a href={siteConfig.email.href}>{siteConfig.email.display}</a>
        <p>{siteConfig.registeredAddressLines[0]}<br />{siteConfig.registeredAddressLines[1]}<br />{siteConfig.registeredAddressLines[2]}</p>
      </div>
    </div>

    <div class="footer__base">
      <span>© {siteConfig.legalName} · Company {siteConfig.companyNumber} · VAT {siteConfig.vatNumber}</span>
      <a href={liveSitePath("/privacy-policy/")}>Privacy</a>
      <a href={assetPath("/legal/terms-and-conditions.pdf")}>Terms</a>
      <a href={liveSitePath("/modern-slavery-statements/")}>Modern Slavery</a>
      <a href={siteConfig.linkedinUrl}>LinkedIn <ArrowIcon direction="up-right" /></a>
    </div>
  </div>
</footer>

<style is:global>
.footer {
  background: var(--navy-950);
  color: var(--cream);
  padding-block: clamp(5rem, 9vw, 8rem) 2rem;
}

.footer__lead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  border-bottom: 1px solid var(--border-light);
  padding-bottom: 4rem;
}

.brand--footer {
  width: clamp(13rem, 20vw, 20rem);
}

.footer__lead p {
  margin-bottom: 0;
  color: var(--lime);
  font-family: var(--font-display);
  font-size: var(--step-1);
  font-style: italic;
  font-weight: 600;
}

.footer__grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.5fr;
  gap: clamp(2rem, 5vw, 6rem);
  padding-block: 4.5rem;
}

.footer__grid > div {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 0.65rem;
}

.footer__grid > div > span {
  margin-bottom: 0.7rem;
  color: var(--lime);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer__grid a,
.footer__grid p {
  color: var(--slate-300);
  font-size: var(--step--1);
  line-height: 1.7;
  transition: color 180ms ease;
}

.footer__grid a:hover {
  color: var(--cream);
}

.footer__contact a:first-of-type {
  color: var(--cream);
  font-family: var(--font-body);
  font-size: var(--step-1);
  font-weight: 600;
}

.footer__contact p {
  margin-top: 0.7rem;
}

.footer__base {
  display: flex;
  align-items: center;
  gap: 1.6rem;
  border-top: 1px solid var(--border-light);
  color: var(--slate-300);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.04em;
  padding-top: 1.7rem;
  text-transform: uppercase;
}

.footer__base a:last-child {
  margin-left: auto;
}

.footer__base a {
  transition: color 180ms ease;
}

.footer__base a:hover {
  color: var(--lime);
}

@media (max-width: 61rem) {
  .footer__grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 42rem) {
  .footer__lead {
    align-items: flex-start;
    flex-direction: column;
  }

  .footer__grid {
    grid-template-columns: 1fr 1fr;
    gap: 3rem 1.5rem;
  }

  .footer__contact {
    grid-column: 1 / -1;
  }

  .footer__base {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .footer__base span {
    width: 100%;
  }

  .footer__base a:last-child {
    margin-left: 0;
  }
}

@media (max-width: 30rem) {
  .footer__grid {
    grid-template-columns: 1fr;
  }

  .footer__contact {
    grid-column: auto;
  }
}
</style>
