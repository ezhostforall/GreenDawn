---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import UtilityBar from "../components/layout/UtilityBar.astro";
import AftercareSection from "../components/home/AftercareSection.astro";
import FeaturedProjectSection from "../components/home/FeaturedProjectSection.astro";
import FinalCtaSection from "../components/home/FinalCtaSection.astro";
import HeroSection from "../components/home/HeroSection.astro";
import InsightsSection from "../components/home/InsightsSection.astro";
import PowerSection from "../components/home/PowerSection.astro";
import ProblemSection from "../components/home/ProblemSection.astro";
import ProcessSection from "../components/home/ProcessSection.astro";
import SolutionsSection from "../components/home/SolutionsSection.astro";
import SupportingProofSection from "../components/home/SupportingProofSection.astro";
import SurveySection from "../components/home/SurveySection.astro";
import SystemSection from "../components/home/SystemSection.astro";
import TechnologySection from "../components/home/TechnologySection.astro";
import TrustSection from "../components/home/TrustSection.astro";
---

<BaseLayout
  title="Commercial EV Charging Installation | GreenDawn"
  description="Commercial EV charging for workplaces, fleets, dealerships and multi-site estates. Survey, design, installation, power planning and aftercare across Great Britain."
>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <UtilityBar />
  <SiteHeader />

  <main id="main-content">
    <HeroSection />
    <TrustSection />
    <ProblemSection />
    <SystemSection />
    <SolutionsSection />
    <ProcessSection />
    <PowerSection />
    <FeaturedProjectSection />
    <SurveySection />
    <TechnologySection />
    <AftercareSection />
    <SupportingProofSection />
    <InsightsSection />
    <FinalCtaSection />
  </main>

  <SiteFooter />

  <script>
    import "../scripts/home";
  </script>
</BaseLayout>
