---
import BaseLayout from "../layouts/BaseLayout.astro";

const site = "https://greendawn.co.uk";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;

const systemLayers = [
  {
    number: "01",
    title: "Infrastructure",
    copy: "Capacity, distribution, civils and dynamic load management — engineered around the site before hardware is specified.",
    detail: "Power first",
  },
  {
    number: "02",
    title: "Chargers",
    copy: "AC and DC hardware selected for dwell time, vehicles, users and whole-life value — not a preferred sales quota.",
    detail: "Fit for purpose",
  },
  {
    number: "03",
    title: "Software",
    copy: "Access, payments, monitoring, tariffs, reporting and remote management brought into one operational view.",
    detail: "Visible and controlled",
  },
];

const process = [
  {
    number: "01",
    title: "Advise",
    copy: "A no-obligation audit builds a clear picture of your sites, vehicles, users, funding options and likely future demand.",
  },
  {
    number: "02",
    title: "Design",
    copy: "Electrical, civil, hardware and software decisions are resolved together before installation begins.",
  },
  {
    number: "03",
    title: "Install",
    copy: "One team coordinates infrastructure, hardware, commissioning and handover, with clear progress throughout.",
  },
  {
    number: "04",
    title: "Support",
    copy: "Monitoring, maintenance and user support keep the charging estate safe, available and commercially effective.",
  },
];

const solutions = [
  {
    number: "01",
    title: "Workplace charging",
    copy: "Practical charging for staff, visitors and company vehicles, with access, reporting and future expansion designed in.",
    href: `${site}/workplace-charging/`,
    image: asset("/images/workplace-charger.avif"),
    alt: "Commercial EV charger installed at a workplace",
  },
  {
    number: "02",
    title: "Fleet charging",
    copy: "Depot infrastructure built around duty cycles, dwell times, available power and the operational cost of downtime.",
    href: `${site}/fleet-charging-solutions/`,
    image: asset("/images/salvation-army.png"),
    alt: "EV chargers installed for a commercial fleet site",
  },
  {
    number: "03",
    title: "Public charging",
    copy: "Reliable destination and public charging with payments, monitoring, accessibility and support considered from day one.",
    href: `${site}/public-charging/`,
    image: asset("/images/elite-hotels.png"),
    alt: "EV chargers installed in front of a hotel",
  },
  {
    number: "04",
    title: "Car dealerships",
    copy: "Brand-aligned charging for workshops, demonstrators, customers and complex multi-site dealer groups.",
    href: `${site}/guides/ev-charging-for-car-dealership/`,
    image: asset("/images/volkswagen-showroom.png"),
    alt: "Rapid EV charging equipment at a Volkswagen dealership",
  },
];

const metrics = [
  { value: 1000, suffix: "+", label: "chargers installed" },
  { value: 200, suffix: "+", label: "locations" },
  { value: 2, prefix: "£", suffix: "m+", label: "funding secured" },
  { value: 5000, suffix: "+", label: "users supported" },
];

const projects = [
  {
    client: "The Salvation Army",
    meta: "Fleet · Nationwide",
    result: "70+ chargepoints across more than 45 locations",
    copy: "A programme that grew from smaller AC installations into complex distribution-centre infrastructure and ongoing management.",
    image: asset("/images/salvation-army.png"),
    alt: "A row of fleet EV chargers installed for The Salvation Army",
  },
  {
    client: "Elite Hotels Group",
    meta: "Destination · Three sites",
    result: "14 sockets with a concierge charging experience",
    copy: "A tailored public-charging system designed around premium guest service, restricted working hours and the hotels’ visual environment.",
    image: asset("/images/elite-hotels.png"),
    alt: "EV chargers outside an Elite Hotels property",
  },
  {
    client: "Honda showrooms",
    meta: "Dealership · Eight sites",
    result: "30 sockets delivered across the group",
    copy: "Consistent, brand-aligned charging configured for different showroom layouts, site usage and operational requirements.",
    image: asset("/images/volvo-installation.png"),
    alt: "An engineer installing a rapid EV charger at a dealership",
  },
];

const insights = [
  {
    label: "Site delivery",
    title: "EV installation day: what to expect from start to finish",
    href: `${site}/guides/ev-installation-day-and-beyond/`,
    image: asset("/images/installation-day.avif"),
    alt: "An electrician testing an EV charging installation",
  },
  {
    label: "Dealerships",
    title: "What most dealership charging projects get wrong",
    href: `${site}/guides/ev-charging-for-car-dealership/`,
    image: asset("/images/dealership-guide.avif"),
    alt: "A vehicle connected to a charger outside a dealership",
  },
  {
    label: "Fleet strategy",
    title: "Transitioning to electric fleets",
    href: `${site}/guides/transitioning-to-electric-fleets/`,
    image: asset("/images/fleet-guide.avif"),
    alt: "A large row of commercial fleet vehicles",
  },
];
---

<BaseLayout
  title="Greendawn — EV charging. Handled."
  description="Commercial EV charging infrastructure, installation, software and aftercare delivered by one accountable nationwide partner."
>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <div class="utility-bar">
    <p>Nationwide commercial EV charging infrastructure</p>
    <div>
      <a href="tel:03455120044">0345 512 0044</a>
      <span aria-hidden="true">·</span>
      <a href={`${site}/customer-care/`}>Customer support</a>
    </div>
  </div>

  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="Greendawn homepage">
      <img src={asset("/brand/greendawn-wordmark.png")} alt="Greendawn" width="1920" height="528" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#system">The system</a>
      <a href="#solutions">Solutions</a>
      <a href="#aftercare">Aftercare</a>
      <a href="#projects">Projects</a>
      <a href="#insights">Insights</a>
    </nav>

    <a class="header-cta" href={`${site}/enquire/`}>
      Book a site audit
      <span aria-hidden="true">↗</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">
      <span class="sr-only">Open navigation</span>
      <span></span>
      <span></span>
    </button>

    <div class="mobile-nav" id="mobile-navigation" aria-hidden="true">
      <nav aria-label="Mobile navigation">
        <a href="#system"><span>01</span>The system</a>
        <a href="#solutions"><span>02</span>Solutions</a>
        <a href="#aftercare"><span>03</span>Aftercare</a>
        <a href="#projects"><span>04</span>Projects</a>
        <a href="#insights"><span>05</span>Insights</a>
      </nav>
      <a class="button button--lime" href={`${site}/enquire/`}>Book a site audit <span>↗</span></a>
      <p><a href="tel:03455120044">0345 512 0044</a> · <a href={`${site}/customer-care/`}>Support</a></p>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top" data-hero>
      <div class="hero__media" aria-hidden="true">
        <img src={asset("/images/hero-engineers.jpg")} alt="" width="2048" height="1536" data-hero-image />
      </div>
      <div class="hero__shade" aria-hidden="true"></div>
      <svg class="hero__arc" viewBox="0 0 900 470" fill="none" aria-hidden="true">
        <path data-arc-path d="M32 438C174 83 602 -77 868 222" />
      </svg>

      <div class="hero__content page-shell">
        <div class="hero__copy">
          <p class="eyebrow eyebrow--light" data-hero-item>
            <span>Commercial EV charging</span>
            <span>Nationwide</span>
          </p>
          <h1 aria-label="EV charging. Handled.">
            <span class="hero-line"><span data-hero-line>EV charging.</span></span>
            <span class="hero-line hero-line--accent"><span data-hero-line>Handled.</span></span>
          </h1>
          <p class="hero__lead" data-hero-item>
            From electrical infrastructure and installation to software and ongoing support, Greendawn gives you one accountable partner for the complete charging estate.
          </p>
          <div class="hero__actions" data-hero-item>
            <a class="button button--lime" href={`${site}/enquire/`}>
              Book a no-obligation site audit <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link text-link--light" href={`${site}/gallery/`}>
              Explore our projects <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="hero__assurances" data-hero-item>
            <li>Charger-agnostic advice</li>
            <li>UK-wide delivery</li>
            <li>Support after installation</li>
          </ul>
        </div>

        <div class="hero__caption" data-hero-item>
          <span>Live infrastructure</span>
          <p>Greendawn engineers commissioning a commercial electrical system.</p>
        </div>
      </div>

      <div class="hero__proof">
        <div><span>01</span><strong>Advise</strong><small>Clear, site-specific planning</small></div>
        <div><span>02</span><strong>Install</strong><small>One coordinated delivery team</small></div>
        <div><span>03</span><strong>Support</strong><small>One accountable relationship</small></div>
      </div>
    </section>

    <section class="trust page-shell" aria-labelledby="trust-title">
      <div class="trust__intro">
        <p class="eyebrow" id="trust-title">Trusted delivery</p>
        <p>Accredited to deliver, proven across complex commercial estates.</p>
      </div>
      <div class="trust__credentials" aria-label="Greendawn accreditations">
        <img src={asset("/credentials/ozev.png")} alt="OZEV authorised installer" loading="lazy" />
        <img src={asset("/credentials/napit.png")} alt="NAPIT approved" loading="lazy" />
        <img src={asset("/credentials/smas.png")} alt="SMAS Worksafe" loading="lazy" />
      </div>
      <div class="trust__clients" aria-label="Selected Greendawn clients">
        <span>Johnsons Cars</span>
        <span>The Salvation Army</span>
        <span>Elite Hotels</span>
        <span>Honda</span>
      </div>
    </section>

    <section class="problem section section--cream" data-section="problem">
      <div class="page-shell problem__layout">
        <div class="section-intro section-intro--sticky" data-reveal>
          <p class="eyebrow">Why Greendawn</p>
          <h2>EV charging becomes complicated when nobody owns the whole system.</h2>
          <p>
            Power, groundworks, chargers, payments and support are often split between different suppliers. When something fails, the customer becomes the project manager.
          </p>
        </div>

        <div class="problem__model" data-problem-model>
          <p class="problem__label">The fragmented model</p>
          <div class="problem__fragments">
            <span data-fragment>Legislation</span>
            <span data-fragment>Electrical design</span>
            <span data-fragment>Groundworks</span>
            <span data-fragment>Charging hardware</span>
            <span data-fragment>Software</span>
            <span data-fragment>Driver support</span>
          </div>
          <div class="problem__connector" aria-hidden="true"><span></span></div>
          <div class="problem__answer" data-answer>
            <span>One accountable partner</span>
            <strong>Advice to aftercare.</strong>
            <p>No hand-offs to manage. One number to call.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="system section" id="system" data-system>
      <div class="system__header page-shell" data-reveal>
        <p class="eyebrow eyebrow--light">The complete system</p>
        <h2>We look beyond the charger.</h2>
        <p>Reliable charging depends on three connected layers. Greendawn plans and manages all three.</p>
      </div>

      <div class="system__stage page-shell">
        <svg class="system__arc" viewBox="0 0 1200 490" fill="none" aria-hidden="true">
          <path data-system-path d="M21 432C190 75 762 -91 1171 241" />
        </svg>
        <div class="system__cards">
          {systemLayers.map((layer) => (
            <article class="system-card" data-system-card>
              <div class="system-card__top">
                <span>{layer.number}</span>
                <span>{layer.detail}</span>
              </div>
              <h3>{layer.title}</h3>
              <p>{layer.copy}</p>
            </article>
          ))}
        </div>
        <p class="system__statement" data-reveal>We fix the foundations first, then build the right charging system around them.</p>
      </div>
    </section>

    <section class="process section section--paper" id="process">
      <div class="page-shell">
        <div class="section-title-row" data-reveal>
          <div>
            <p class="eyebrow">One partner, end to end</p>
            <h2>From uncertainty to a managed charging estate.</h2>
          </div>
          <p>Every stage resolves a different kind of risk, but accountability stays in one place.</p>
        </div>

        <div class="process__steps" data-process>
          <div class="process__line" aria-hidden="true"><span data-process-line></span></div>
          {process.map((step) => (
            <article class="process-step" data-process-step>
              <span class="process-step__number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="solutions section section--cream" id="solutions" data-solutions>
      <div class="page-shell">
        <div class="section-title-row" data-reveal>
          <div>
            <p class="eyebrow">Commercial solutions</p>
            <h2>Different sites need different charging strategies.</h2>
          </div>
          <p>Selected around the way people, vehicles and power move through the site.</p>
        </div>

        <div class="solutions__layout">
          <div class="solutions__media" aria-live="polite">
            {solutions.map((solution, index) => (
              <figure class:list={["solution-image", { "is-active": index === 0 }]} data-solution-image={index}>
                <img src={solution.image} alt={solution.alt} loading={index === 0 ? "eager" : "lazy"} />
                <figcaption><span>{solution.number}</span>{solution.title}</figcaption>
              </figure>
            ))}
            <div class="solutions__media-mark" aria-hidden="true">GREEND<span>AWN</span></div>
          </div>

          <div class="solutions__list">
            {solutions.map((solution, index) => (
              <a class:list={["solution-row", { "is-active": index === 0 }]} href={solution.href} data-solution-row={index}>
                <span class="solution-row__number">{solution.number}</span>
                <div>
                  <h3>{solution.title}</h3>
                  <p>{solution.copy}</p>
                </div>
                <span class="solution-row__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="aftercare section" id="aftercare" data-aftercare>
      <div class="aftercare__orb" aria-hidden="true" data-aftercare-orb></div>
      <div class="page-shell aftercare__layout">
        <div class="aftercare__copy" data-reveal>
          <p class="eyebrow eyebrow--light">Aftercare</p>
          <h2>Installation is the beginning, not the end.</h2>
          <p>
            A charger is a live electrical asset, a network-connected device and, in many cases, a payment terminal. Greendawn keeps those moving parts visible, supported and accountable.
          </p>
          <a class="button button--lime" href={`${site}/aftercare/`}>Explore aftercare <span aria-hidden="true">↗</span></a>
        </div>

        <div class="aftercare__services">
          <article data-reveal>
            <span>01</span>
            <h3>Back-office software</h3>
            <p>Usage, access, payments, reporting and remote diagnostics in one operational view.</p>
          </article>
          <article data-reveal>
            <span>02</span>
            <h3>Inspection and testing</h3>
            <p>Planned checks that protect electrical safety, compliance, performance and warranties.</p>
          </article>
          <article data-reveal>
            <span>03</span>
            <h3>Complete care</h3>
            <p>Troubleshooting, maintenance, software updates and clear escalation when a fault occurs.</p>
          </article>
          <article data-reveal>
            <span>04</span>
            <h3>Driver support</h3>
            <p>A recognisable point of contact for charging, access and payment problems.</p>
          </article>
        </div>
      </div>
      <blockquote class="aftercare__quote page-shell" data-reveal>
        “If it’s not working, that’s our problem to fix.”
      </blockquote>
    </section>

    <section class="metrics section section--lime" aria-labelledby="metrics-title" data-metrics>
      <div class="page-shell">
        <div class="metrics__intro" data-reveal>
          <p class="eyebrow" id="metrics-title">Reported delivery</p>
          <h2>Real installs. Real operational scale.</h2>
        </div>
        <div class="metrics__grid">
          {metrics.map((metric) => (
            <div class="metric">
              <strong
                data-counter
                data-value={metric.value}
                data-prefix={metric.prefix ?? ""}
                data-suffix={metric.suffix}
              >
                {metric.prefix}{metric.value.toLocaleString("en-GB")}{metric.suffix}
              </strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </div>
        <p class="metrics__note">Figures supplied in Greendawn’s June 2026 pitch deck. Confirm final reporting definitions before publication.</p>
      </div>
    </section>

    <section class="case-study section section--paper" id="projects" data-case-study>
      <div class="page-shell case-study__layout">
        <figure class="case-study__media" data-case-image>
          <img src={asset("/images/johnsons-chargers.png")} alt="A mixed array of rapid and AC chargers installed at a Johnsons Cars dealership" loading="lazy" />
          <figcaption>Johnsons Cars · Nationwide dealership programme</figcaption>
        </figure>

        <div class="case-study__story">
          <p class="eyebrow">Featured project</p>
          <h2>One charging standard across 60 very different sites.</h2>
          <p class="case-study__lead">
            Johnsons Cars needed a national EV partner able to deliver AC and DC charging against 11 manufacturer standards — without losing sight of how each dealership operated.
          </p>
          <div class="case-study__facts">
            <div><strong>281</strong><span>chargers delivered</span></div>
            <div><strong>60</strong><span>locations</span></div>
            <div><strong>11</strong><span>manufacturer standards</span></div>
          </div>
          <p>
            The network was brought into a single management system, giving portfolio, site and charger-level visibility of usage, carbon savings and performance.
          </p>
          <blockquote>
            “Greendawn has taken the headache out of our EV charging rollout.”
          </blockquote>
          <a class="text-link" href={`${site}/gallery/`}>Explore the project portfolio <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="project-grid section section--cream" aria-labelledby="project-grid-title">
      <div class="page-shell">
        <div class="section-title-row section-title-row--compact" data-reveal>
          <div>
            <p class="eyebrow">Proven in the real world</p>
            <h2 id="project-grid-title">Different operations. The same accountability.</h2>
          </div>
          <a class="text-link" href={`${site}/gallery/`}>View all projects <span aria-hidden="true">→</span></a>
        </div>
        <div class="project-grid__items">
          {projects.map((project) => (
            <article class="project-card" data-reveal>
              <figure>
                <img src={project.image} alt={project.alt} loading="lazy" />
                <figcaption>{project.meta}</figcaption>
              </figure>
              <h3>{project.client}</h3>
              <strong>{project.result}</strong>
              <p>{project.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="technology section section--paper" data-technology>
      <div class="page-shell technology__layout">
        <div class="technology__copy" data-reveal>
          <p class="eyebrow">Charger-agnostic</p>
          <h2>Built around your operation — not a preferred charger.</h2>
          <p>
            Hardware follows the evidence. Greendawn considers the electrical system, vehicles, users, software, support and future demand before recommending AC or DC equipment.
          </p>
          <a class="text-link" href={`${site}/what-you-need-to-know/`}>Explore charging technology <span aria-hidden="true">→</span></a>
        </div>

        <div class="technology__visual" data-reveal>
          <div class="technology__image technology__image--one">
            <img src={asset("/images/ford-charging.png")} alt="Ford-branded commercial EV charging points" loading="lazy" />
          </div>
          <div class="technology__image technology__image--two">
            <img src={asset("/images/project-ev-dual.png")} alt="A dual 40 kW Project EV charging unit" loading="lazy" />
          </div>
          <div class="technology__criteria">
            <span>Charging speed</span>
            <span>Reliability</span>
            <span>Compatibility</span>
            <span>Payment method</span>
            <span>Warranty</span>
            <span>Whole-life cost</span>
          </div>
        </div>
      </div>
    </section>

    <section class="capability section section--navy">
      <div class="page-shell capability__grid">
        <article data-reveal>
          <p class="eyebrow eyebrow--light">Nationwide delivery</p>
          <h2>National reach, grounded in the reality of each site.</h2>
          <p>
            From individual workplaces to coordinated multi-site programmes, Greendawn brings surveys, design, installation, commissioning and ongoing support into one delivery model.
          </p>
          <ul>
            <li>Single and multi-site surveys</li>
            <li>Central project accountability</li>
            <li>Consistent engineering standards</li>
            <li>Ongoing estate-level support</li>
          </ul>
        </article>

        <article class="capability__funding" data-reveal>
          <p class="eyebrow">Funding and planning</p>
          <h2>Understand the commercial case before committing.</h2>
          <p>
            Greendawn can identify relevant funding routes, test project assumptions and plan infrastructure that can grow without avoidable rework.
          </p>
          <div>
            <span>01</span><strong>Funding guidance</strong><small>Current routes and eligibility</small>
          </div>
          <div>
            <span>02</span><strong>Site planning</strong><small>Capacity and future phases</small>
          </div>
          <div>
            <span>03</span><strong>Whole-life value</strong><small>Hardware, software and support</small>
          </div>
          <a class="button button--navy" href={`${site}/enquire/`}>Discuss your site <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </section>

    <section class="insights section section--cream" id="insights">
      <div class="page-shell">
        <div class="section-title-row section-title-row--compact" data-reveal>
          <div>
            <p class="eyebrow">Practical guidance</p>
            <h2>Make better-informed charging decisions.</h2>
          </div>
          <a class="text-link" href={`${site}/blog/`}>Visit the insight centre <span aria-hidden="true">→</span></a>
        </div>

        <div class="insights__grid">
          {insights.map((insight) => (
            <a class="insight-card" href={insight.href} data-reveal>
              <figure>
                <img src={insight.image} alt={insight.alt} loading="lazy" />
                <span aria-hidden="true">↗</span>
              </figure>
              <p>{insight.label}</p>
              <h3>{insight.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta section" data-final-cta>
      <svg viewBox="0 0 1000 550" fill="none" aria-hidden="true">
        <path data-final-arc d="M23 526C216 90 740 -71 974 233" />
      </svg>
      <div class="page-shell final-cta__inner" data-reveal>
        <p class="eyebrow">Start with clarity</p>
        <h2>EV charging you don’t have to manage.</h2>
        <p>Begin with a no-obligation review of your site, objectives and existing electrical infrastructure.</p>
        <div class="final-cta__actions">
          <a class="button button--navy" href={`${site}/enquire/`}>Book a site audit <span aria-hidden="true">↗</span></a>
          <p>Prefer to speak first? <a href="tel:03455120044">0345 512 0044</a></p>
        </div>
        <ol>
          <li><span>01</span>Initial conversation</li>
          <li><span>02</span>Site and requirements review</li>
          <li><span>03</span>Clear recommended next steps</li>
        </ol>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="page-shell">
      <div class="footer__lead">
        <a class="brand brand--footer" href="#top" aria-label="Greendawn homepage">
          <img src={asset("/brand/greendawn-wordmark.png")} alt="Greendawn" width="1920" height="528" />
        </a>
