---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import UtilityBar from "../components/layout/UtilityBar.astro";
import LeadCapture from "../components/lead/LeadCapture.astro";
import AftercareSection from "../components/home/AftercareSection.astro";
import FeaturedProjectSection from "../components/home/FeaturedProjectSection.astro";
import FinalCtaSection from "../components/home/FinalCtaSection.astro";
import HeroSection from "../components/home/HeroSection.astro";
import InsightsSection from "../components/home/InsightsSection.astro";
import ProblemSection from "../components/home/ProblemSection.astro";
import ProcessSection from "../components/home/ProcessSection.astro";
import SolutionsSection from "../components/home/SolutionsSection.astro";
import SupportingProofSection from "../components/home/SupportingProofSection.astro";
import SurveySection from "../components/home/SurveySection.astro";
import SystemSection from "../components/home/SystemSection.astro";
import TrustSection from "../components/home/TrustSection.astro";
---

<BaseLayout
  title="Commercial EV Charging Infrastructure | Greendawn"
  description="Greendawn plans, installs and supports commercial EV charging infrastructure for fleets, workplaces, dealerships and multi-site estates across Great Britain."
>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <UtilityBar />
  <SiteHeader />

  <main id="main-content">
    <HeroSection />
    <TrustSection />
    <ProblemSection />
    <SystemSection />
    <ProcessSection />
    <FeaturedProjectSection />
    <SurveySection />
    <SolutionsSection />
    <AftercareSection />
    <SupportingProofSection />
    <InsightsSection />
    <FinalCtaSection />
  </main>

  <SiteFooter />
  <LeadCapture source="homepage" />

  <script>
    import "../scripts/home";
  </script>
</BaseLayout>

<style is:global>
@media (max-width: 42rem) {
  .trust + .problem {
    padding-top: 2.75rem;
  }

  .proof-grid + .insights {
    padding-top: 2.5rem;
  }
}

@media (max-width: 30rem) {
  .trust + .problem {
    padding-top: 2.5rem;
  }
}
</style>
